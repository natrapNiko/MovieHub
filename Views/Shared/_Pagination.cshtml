@model PaginationViewModel
@{
    var query = new Dictionary<string, string>();
    foreach (var kvp in Context.Request.Query)
    {
        if (!string.Equals(kvp.Key, "page", StringComparison.OrdinalIgnoreCase))
        {
            query[kvp.Key] = kvp.Value.ToString();
        }
    }

    Dictionary<string, string> RouteFor(int page)
    {
        var merged = new Dictionary<string, string>(query) { ["page"] = page.ToString() };
        return merged;
    }

    var start = Math.Max(1, Model.CurrentPage - 2);
    var end = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Pagination" class="mh-pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@RouteFor(Model.CurrentPage - 1)" aria-label="Previous">&laquo;</a>
            </li>
            @if (start > 1)
            {
                <li class="page-item"><a class="page-link" asp-action="@Model.Action" asp-all-route-data="@RouteFor(1)">1</a></li>
                @if (start > 2)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
            }
            @for (var i = start; i <= end; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@RouteFor(i)">@i</a>
                </li>
            }
            @if (end < Model.TotalPages)
            {
                @if (end < Model.TotalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                <li class="page-item"><a class="page-link" asp-action="@Model.Action" asp-all-route-data="@RouteFor(Model.TotalPages)">@Model.TotalPages</a></li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@RouteFor(Model.CurrentPage + 1)" aria-label="Next">&raquo;</a>
            </li>
        </ul>
    </nav>
}
