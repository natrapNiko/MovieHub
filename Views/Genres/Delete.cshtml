@model Genre
@{
    ViewData["Title"] = "Delete Genre";
}

<div class="container py-4">
    <h1 class="section-title mb-4 text-danger">Delete Genre</h1>

    <div class="mh-form">
        <p>Are you sure you want to delete <strong>@Model.Name</strong>? Movies using this genre must be reassigned first (deleting a genre that still has movies will fail).</p>

        <form asp-controller="Genres" asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
            <a asp-controller="Genres" asp-action="Index" class="btn btn-outline-light">Cancel</a>
        </form>
    </div>
</div>
