@model Genre
@{
    ViewData["Title"] = "New Genre";
}

<div class="container py-4">
    <h1 class="section-title mb-4">New Genre</h1>

    <form asp-controller="Genres" asp-action="Create" method="post" class="mh-form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-accent"><i class="bi bi-check-lg"></i> Create</button>
        <a asp-controller="Genres" asp-action="Index" class="btn btn-outline-light">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
