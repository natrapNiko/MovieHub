@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container error-page text-center py-5">
    <div class="error-code">403</div>
    <h1 class="mt-3">@Model.Title</h1>
    <p class="text-muted lead">@Model.Message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-accent mt-3">Back to Home</a>
</div>
