@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container error-page text-center py-5">
    <i class="bi bi-exclamation-triangle-fill display-1 text-accent"></i>
    <h1 class="mt-3">@Model.Title</h1>
    <p class="text-muted lead">@Model.Message</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-accent mt-3">Back to Home</a>
</div>
