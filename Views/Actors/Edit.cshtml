@model ActorFormViewModel
@{
    ViewData["Title"] = "Edit Actor";
}

<div class="container py-4">
    <h1 class="section-title mb-4">Edit Actor</h1>

    <form asp-controller="Actors" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mh-form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />
        <partial name="_ActorFormFields" />

        <button type="submit" class="btn btn-accent mt-3"><i class="bi bi-check-lg"></i> Save Changes</button>
        <a asp-controller="Actors" asp-action="Index" class="btn btn-outline-light mt-3">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
