@model ActorFormViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="BirthDate" class="form-label"></label>
        <input asp-for="BirthDate" class="form-control" type="date" />
        <span asp-validation-for="BirthDate" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PhotoUrl" class="form-label"></label>
        <input asp-for="PhotoUrl" class="form-control" placeholder="https://&hellip;" />
        <span asp-validation-for="PhotoUrl" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Biography" class="form-label"></label>
        <textarea asp-for="Biography" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Biography" class="text-danger"></span>
    </div>
</div>
